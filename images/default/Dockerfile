RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260823T000000Z/|g; s|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260823T000000Z/|g' /etc/apt/sources.list.d/ubuntu.sources && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd-sysv=255.4-1ubuntu8.17 ca-certificates=20260601~24.04.1 curl=8.5.0-2ubuntu10.12 iproute2=6.1.0-1ubuntu6.4 iputils-ping=3:20240117-1ubuntu0.1 e2fsprogs=1.47.0-2.4~exp1ubuntu4.1 && rm -rf /var/lib/apt/lists/* /etc/machine-id /var/log/* /var/cache/* /tmp/* /var/lib/systemd/random-seed
