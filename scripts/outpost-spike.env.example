# Copy to scripts/outpost-spike.env and set the immutable asset paths and digests.
# This file is intentionally gitignored because it describes this host.
FIRECRACKER_VERSION=v1.16.0
FIRECRACKER=/opt/outpost-spike/firecracker-v1.16.0
JAILER=/opt/outpost-spike/jailer-v1.16.0
KERNEL=/opt/outpost-spike/vmlinux-v1.16.0
BASE_ROOTFS=/opt/outpost-spike/outpost-default-v1.ext4

# Require the SHA-256 values recorded when the pinned artifacts were acquired.
FIRECRACKER_SHA256=REPLACE_WITH_SHA256
JAILER_SHA256=REPLACE_WITH_SHA256
KERNEL_SHA256=REPLACE_WITH_SHA256
BASE_ROOTFS_SHA256=REPLACE_WITH_SHA256

OUTPOSTVM_USER=outpostvm
OUTPOSTVM_GROUP=outpostvm
RUNTIME_BASE=/run/outpost-spike
JAILER_BASE=/srv/outpost/jailer
# The host interface with the default route. Set explicitly; do not guess.
UPLINK_IFACE=eth0
# IPv4 resolver written into each guest's /etc/resolv.conf.
DNS_SERVER=1.1.1.1
