#!/bin/sh
set -eu
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
root=$work/root
artifacts=$work/artifacts
mkdir -p "$root" "$artifacts" "$work/bin"
for name in ark arkd ark-vm-launcher firecracker jailer vmlinux rootfs.ext4 default.oci.tar; do printf 'tiny %s\n' "$name" > "$artifacts/$name"; done
python3 - "$artifacts" <<'PY'
import hashlib,json,os,sys
p=sys.argv[1]; names={'ark':'ark','arkd':'arkd','ark-vm-launcher':'ark-vm-launcher','firecracker':'firecracker','jailer':'jailer','vmlinux':'vmlinux','rootfs.ext4':'rootfs.ext4','default':'default.oci.tar'}
a=[]
for n,f in names.items():
 b=open(os.path.join(p,f),'rb').read(); a.append({'name':n,'file':f,'sha256':hashlib.sha256(b).hexdigest(),'url':'https://example.test/'+f})
open(os.path.join(p,'assets.json'),'w').write(json.dumps({'version':'0.1.0','architecture':'amd64','assets':a},sort_keys=True,separators=(',',':')))
PY
cat > "$work/bin/systemctl" <<'EOF'
#!/bin/sh
echo "$*" >> "$ARK_FAKE_LOG"
[ "${ARK_SYSTEMCTL_FAIL:-0}" = 1 ] && exit 23
EOF
chmod 755 "$work/bin/systemctl"
real_chown=$(command -v chown)
real_ln=$(command -v ln)
cat > "$work/bin/chown" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$ARK_FAKE_CHOWN_LOG"
owner=$1
shift
case "$owner" in "$ARK_INSTALL_ROOT_UID":*) owner=$ARK_INSTALL_UID:$ARK_INSTALL_GID;; esac
exec "$ARK_REAL_CHOWN" "$owner" "$@"
EOF
chmod 755 "$work/bin/chown"
cat > "$work/bin/ln" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$ARK_FAKE_LN_LOG"
exec "$ARK_REAL_LN" "$@"
EOF
chmod 755 "$work/bin/ln"
install_uid=$(id -u)
install_gid=$(id -g)
root_uid=4242
root_gid=4243
run() { PATH="$work/bin:$PATH" ARK_REAL_CHOWN="$real_chown" ARK_FAKE_CHOWN_LOG="$work/chown" ARK_REAL_LN="$real_ln" ARK_FAKE_LN_LOG="$work/ln" ARK_INSTALL_ROOT="$root" ARK_INSTALL_TEST=1 ARK_INSTALL_UID="$install_uid" ARK_INSTALL_GID="$install_gid" ARK_INSTALL_ROOT_UID="$root_uid" ARK_INSTALL_ROOT_GID="$root_gid" ARK_INSTALL_HANDOFF_HOME=/client ARK_INSTALL_HANDOFF_UID="$install_uid" ARK_INSTALL_HANDOFF_GID="$install_gid" SUDO_UID="$install_uid" SUDO_GID="$install_gid" ARK_VERSION=0.1.0 ARK_UPLINK=eth0 ARK_ARTIFACT_DIR="$artifacts" ARK_FAKE_LOG="$work/log" ARK_INSTALL_TEST_SYSTEMCTL="${ARK_INSTALL_TEST_SYSTEMCTL:-0}" ARK_SYSTEMCTL_FAIL="${ARK_SYSTEMCTL_FAIL:-0}" ARK_INSTALL_TEST_FAIL_HARDLINK="${ARK_INSTALL_TEST_FAIL_HARDLINK:-0}" ARK_INSTALL_TEST_LOG="$work/order" "$repo/scripts/install-server"; }
run
[ "$(head -n 2 "$work/order" | tr '\n' ' ')" = 'hardlink identities ' ]
grep -Fqx "$root/srv/ark/state/.ark-hardlink-probe $root/srv/ark/jailer/.ark-hardlink-probe" "$work/ln"
grep -Fqx "$root_uid:$install_gid $root/usr/local/lib/ark" "$work/chown"
grep -q "^$root_uid:$install_gid $root/usr/local/lib/ark/.arkd.new" "$work/chown"
grep -q "^$install_uid:$install_gid $root/var/lib/arkd/images/default/.rootfs.ext4.new" "$work/chown"
grep -Fqx "$root_uid:$root_gid $root/etc/arkd/launcher.env" "$work/chown"
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark")" = "750:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark/arkd")" = "750:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark/default.oci.tar")" = "640:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark/launcher")" = "750:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark/launcher/ark-vm-launcher")" = "750:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/usr/local/lib/ark/launcher/vmlinux")" = "640:$(id -un):$(id -gn)" ]
[ "$(stat -c %a:%U:%G "$root/etc/arkd/launcher.env")" = "600:$(id -un):$(id -gn)" ]
test -x "$root/usr/local/lib/ark/arkd"
grep -q '^ExecStart=/usr/local/lib/ark/arkd ' "$root/etc/systemd/system/arkd.service"
grep -q '^ExecStart=/usr/local/lib/ark/launcher/ark-vm-launcher ' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -q -- '--state-dir=/srv/ark/state' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'RequiresMountsFor=/var/lib/arkd /srv/ark' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'ReadWritePaths=/srv/ark /run/ark /sys/fs/cgroup' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'ReadOnlyPaths=/usr/local/lib/ark/launcher /var/lib/arkd/images/default' "$root/etc/systemd/system/ark-vm-launcher.service"
if grep -Fq 'ReadWritePaths=/srv/ark/' "$root/etc/systemd/system/ark-vm-launcher.service"; then exit 1; fi
grep -Fqx 'PrivateDevices=false' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'DeviceAllow=/dev/kvm rwm' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'DeviceAllow=/dev/net/tun rwm' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'DeviceAllow=/dev/userfaultfd rwm' "$root/etc/systemd/system/ark-vm-launcher.service"
[ "$(grep -c '^DeviceAllow=' "$root/etc/systemd/system/ark-vm-launcher.service")" = 3 ]
grep -q '^CapabilityBoundingSet=.*CAP_FOWNER' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -q '^AmbientCapabilities=.*CAP_FOWNER' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_PTRACE' "$root/etc/systemd/system/ark-vm-launcher.service"
grep -Fqx 'AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_PTRACE' "$root/etc/systemd/system/ark-vm-launcher.service"
if grep -q 'SupplementaryGroups=arkvm' "$root/etc/systemd/system/arkd.service"; then exit 1; fi
if grep -q -- '--firecracker=/usr/local/lib/ark/firecracker' "$root/etc/systemd/system/ark-vm-launcher.service"; then exit 1; fi
mkdir -p "$work/output"
for name in ark arkd ark-vm-launcher; do cp "$artifacts/$name" "$work/output/$name"; done
cp "$artifacts/rootfs.ext4" "$work/output/ark-default-0.1.0-amd64.ext4"
cp "$artifacts/default.oci.tar" "$work/output/ark-default-0.1.0-amd64.oci.tar"
ARK_VERSION=0.1.0 ARK_OUTPUT_DIR="$work/output" ARK_FIRECRACKER="$artifacts/firecracker" ARK_JAILER="$artifacts/jailer" ARK_KERNEL="$artifacts/vmlinux" "$repo/scripts/release-artifacts"
first=$(sha256sum "$work/output/release/assets.json" "$work/output/release/checksums.txt")
printf stale > "$work/output/release/stale"
ARK_VERSION=0.1.0 ARK_OUTPUT_DIR="$work/output" ARK_FIRECRACKER="$artifacts/firecracker" ARK_JAILER="$artifacts/jailer" ARK_KERNEL="$artifacts/vmlinux" "$repo/scripts/release-artifacts"
[ "$first" = "$(sha256sum "$work/output/release/assets.json" "$work/output/release/checksums.txt")" ]
[ ! -e "$work/output/release/stale" ]
artifacts=$work/output/release
run
token=$(cat "$root/etc/arkd/token")
printf legacy > "$root/usr/local/lib/ark/firecracker"
: > "$work/chown"
run
grep -Fqx "$root_uid:$install_gid $root/usr/local/lib/ark" "$work/chown"
grep -q "^$root_uid:$install_gid $root/usr/local/lib/ark/.arkd.new" "$work/chown"
[ ! -e "$root/usr/local/lib/ark/firecracker" ]
[ "$token" = "$(cat "$root/etc/arkd/token")" ]
[ "$(stat -c %a "$root/etc/arkd/token")" = 600 ]
handoff=/client/.config/ark/server.env
[ "$(stat -c %a "$root$handoff")" = 600 ]
grep -qx "ARK_TOKEN=$token" "$root$handoff"
grep -qx 'ARK_SERVER=http://127.0.0.1:17890' "$root$handoff"
[ "$(stat -c %a "$root/etc/systemd/system/arkd.service")" = 644 ]
[ "$(stat -c %a "$root/etc/systemd/system/ark-vm-launcher.service")" = 644 ]
grep -q -- '--listen=127.0.0.1:17890' "$root/etc/systemd/system/arkd.service"
grep -q 'EnvironmentFile=/etc/arkd/launcher.env' "$root/etc/systemd/system/ark-vm-launcher.service"
[ -x "$root/usr/local/bin/ark" ]
[ -d "$root/srv/ark/state" ]
[ ! -e "$root/var/lib/ark-vm-launcher" ]
[ -f "$root/usr/local/lib/ark/default.oci.tar" ]
[ ! -e /usr/local/lib/ark/default.oci.tar ]
[ ! -e /usr/local/bin/ark ]
fail_preapply() {
 rm -rf "$root"; mkdir "$root"
 if run >/dev/null 2>&1; then echo "accepted invalid manifest" >&2; exit 1; fi
 [ ! -e "$root/usr" ] || { echo "applied before preflight" >&2; exit 1; }
}
good=$artifacts
cp -a "$good" "$work/bad"; printf x >> "$work/bad/ark"; artifacts=$work/bad; fail_preapply
cp -a "$good" "$work/missing"; rm "$work/missing/jailer"; artifacts=$work/missing; fail_preapply
cp -a "$good" "$work/duplicate"; artifacts=$work/duplicate python3 - <<'PY'
import json,os
p=os.environ['artifacts']+'/assets.json'; x=json.load(open(p)); x['assets'].append(x['assets'][0]); open(p,'w').write(json.dumps(x))
PY
artifacts=$work/duplicate; fail_preapply
cp -a "$good" "$work/traversal"; artifacts=$work/traversal python3 - <<'PY'
import json,os
p=os.environ['artifacts']+'/assets.json'; x=json.load(open(p)); x['assets'][0]['file']='../ark'; open(p,'w').write(json.dumps(x))
PY
artifacts=$work/traversal; fail_preapply
cp -a "$good" "$work/arch"; artifacts=$work/arch python3 - <<'PY'
import json,os
p=os.environ['artifacts']+'/assets.json'; x=json.load(open(p)); x['architecture']='arm64'; open(p,'w').write(json.dumps(x))
PY
artifacts=$work/arch; fail_preapply
for kind in version extra duplicate-file malformed-digest; do
 artifacts=$work/$kind; cp -a "$good" "$artifacts"
 ARK_KIND=$kind ARK_DIR=$artifacts python3 - <<'PY'
import json,os
p=os.environ['ARK_DIR']+'/assets.json'; x=json.load(open(p)); k=os.environ['ARK_KIND']
if k=='version': x['version']='9.9.9'
elif k=='extra': x['assets'].append({'name':'extra','file':'extra','sha256':'a'*64,'url':'https://example.test/extra'})
elif k=='duplicate-file': x['assets'][1]['file']=x['assets'][0]['file']
elif k=='malformed-digest': x['assets'][0]['sha256']='G'*64
open(p,'w').write(json.dumps(x,separators=(',',':')))
PY
 fail_preapply
done
artifacts=$work/symlink-manifest; cp -a "$good" "$artifacts"; mv "$artifacts/assets.json" "$artifacts/real.json"; ln -s real.json "$artifacts/assets.json"; fail_preapply
rm -rf "$root"; mkdir "$root"; artifacts=$work/symlink; cp -a "$good" "$artifacts"; rm "$artifacts/jailer"; ln -s ark "$artifacts/jailer"; fail_preapply
artifacts=$good; rm -rf "$root"; mkdir "$root"; ARK_INSTALL_TEST_FAIL_HARDLINK=1 run >/dev/null 2>&1 && { echo 'hardlink failure accepted' >&2; exit 1; }
artifacts=$good; ARK_INSTALL_TEST_SYSTEMCTL=1 ARK_SYSTEMCTL_FAIL=1 run >/dev/null 2>&1 && { echo 'systemctl failure accepted' >&2; exit 1; }
grep -q 'daemon-reload' "$work/log"
invalid_input() { rm -rf "$root"; mkdir "$root"; if env PATH="$work/bin:$PATH" ARK_INSTALL_ROOT="$root" ARK_INSTALL_TEST=1 ARK_INSTALL_UID="$(id -u)" ARK_INSTALL_GID="$(id -g)" ARK_INSTALL_HANDOFF_HOME=/client ARK_INSTALL_HANDOFF_UID="$(id -u)" ARK_INSTALL_HANDOFF_GID="$(id -g)" SUDO_UID="$(id -u)" SUDO_GID="$(id -g)" ARK_VERSION=0.1.0 ARK_UPLINK=eth0 ARK_ARTIFACT_DIR="$good" "$@" "$repo/scripts/install-server" >/dev/null 2>&1; then echo 'invalid input accepted' >&2; exit 1; fi; [ ! -e "$root/usr" ]; }
invalid_input 'ARK_UPLINK=eth0|bad'
invalid_input ARK_DNS=not-an-ip
invalid_input 'ARK_LISTEN=0.0.0.0:17890'
invalid_input 'ARK_CLIENT_HANDOFF=/etc/../outside'
rm -rf "$root"; mkdir "$root"
if PATH="$work/bin:$PATH" ARK_INSTALL_ROOT="$root" ARK_INSTALL_TEST=1 ARK_INSTALL_UID="$(id -u)" ARK_INSTALL_GID="$(id -g)" ARK_VERSION=0.1.0 ARK_UPLINK=eth0 ARK_RELEASE_URL=https://example.test ARK_ASSETS_MANIFEST_SHA256=xyz "$repo/scripts/install-server" >/dev/null 2>&1; then echo 'malformed remote checksum accepted' >&2; exit 1; fi
[ ! -e "$root/usr" ]
printf '%s\n' 'TestInstallServerIntegration'
