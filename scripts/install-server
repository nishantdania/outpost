#!/bin/sh
# Install one privileged launcher and its local CLI. No API daemon or token.
set -eu
root=${OUTPOST_INSTALL_ROOT:-}
test_mode=${OUTPOST_INSTALL_TEST:-0}
[ "$test_mode" != 1 ] || [ -n "$root" ] || exit 1
version=${OUTPOST_VERSION:?OUTPOST_VERSION is required}
[ -z "$root" ] || [ "$test_mode" = 1 ] || { echo 'installation root is only available in test mode' >&2; exit 1; }
case "$root" in /|*/../*|*/..|*/./*|*/.) echo 'unsafe test root' >&2; exit 1;; ''|/*) :;; *) exit 1;; esac
# Reject the retired layout before installing packages, changing ownership, or
# replacing binaries. Never silently mix incompatible schema/runtime lineages.
for legacy in /var/lib/outpostd /etc/systemd/system/outpostd.service; do
 if [ -e "$root$legacy" ] || [ -L "$root$legacy" ]; then
  echo "retired installation found at $legacy; preserve/export its disks before explicitly removing it" >&2
  exit 1
 fi
done
for path in /var/lib/outpost /var/lib/outpost/images /var/lib/outpost/images/default /srv /srv/outpost /srv/outpost/state /srv/outpost/jailer /etc/outpost /usr/local/lib/outpost /usr/local/lib/outpost/launcher; do
 [ ! -L "$root$path" ] || { echo "refusing symlink: $path" >&2; exit 1; }
done
printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || exit 1
admin_user=${OUTPOST_ADMIN_USER:-}
if [ -n "$admin_user" ]; then
 case "$admin_user" in [!A-Za-z_]*|*[!A-Za-z0-9_-]*) echo 'invalid administrator username' >&2; exit 1;; esac
 [ "${#admin_user}" -le 32 ] || { echo 'invalid administrator username' >&2; exit 1; }
 if [ "$test_mode" != 1 ]; then
  id "$admin_user" >/dev/null 2>&1 || { echo "administrator account does not exist: $admin_user" >&2; exit 1; }
  command -v usermod >/dev/null 2>&1 || { echo 'missing usermod' >&2; exit 1; }
 fi
fi
if [ "$test_mode" != 1 ]; then
 [ "$(id -u)" = 0 ] || { echo 'must run as root' >&2; exit 1; }
 [ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || { echo 'Linux x86-64 is required' >&2; exit 1; }
 if command -v apt-get >/dev/null 2>&1; then
  apt-get update
  apt-get install -y curl zstd iproute2 nftables python3
 fi
 for command in curl zstd ip nft python3 sha256sum install groupadd useradd getent systemctl; do
  command -v "$command" >/dev/null 2>&1 || { echo "missing $command; install dependencies through your normal system upgrade" >&2; exit 1; }
 done
 if [ ! -c /dev/kvm ] || [ ! -c /dev/net/tun ] || [ ! -c /dev/userfaultfd ] || [ ! -f /sys/fs/cgroup/cgroup.controllers ]; then
  echo 'KVM, TUN, userfaultfd and cgroup v2 are required' >&2
  exit 1
 fi
 [ "$(cat /proc/sys/net/ipv4/ip_forward)" = 1 ] || { echo 'enable IPv4 forwarding before installation' >&2; exit 1; }
fi
uplink=${OUTPOST_UPLINK:-$(ip -4 route show default | awk 'NR == 1 {print $5}')}
python3 - "$uplink" <<'PY'
import re,sys
if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}',sys.argv[1]): raise SystemExit('invalid uplink')
PY
umask 077
stage=$(mktemp -d "$root/.outpost-install.XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
source=${OUTPOST_ARTIFACT_DIR:-}
if [ -z "$source" ]; then
 base=${OUTPOST_RELEASE_URL:?OUTPOST_RELEASE_URL is required}
 want=${OUTPOST_ASSETS_MANIFEST_SHA256:?OUTPOST_ASSETS_MANIFEST_SHA256 is required}
 case "$base" in https://*) :;; *) echo 'release URL must use HTTPS' >&2; exit 1;; esac
 curl --fail --location --proto '=https' --tlsv1.2 -o "$stage/assets.json" "$base/assets.json"
 [ "$(sha256sum "$stage/assets.json" | awk '{print $1}')" = "$want" ] || { echo 'manifest checksum mismatch' >&2; exit 1; }
 source=$stage
fi
# Validate the complete manifest before downloading or copying any named asset.
python3 - "$source/assets.json" "$version" "$stage/downloads" "$stage/validated-assets.json" <<'PY'
import json,os,re,stat,sys,urllib.parse
required={'outpost':'outpost','outpost-vm-launcher':'outpost-vm-launcher','firecracker':'firecracker','jailer':'jailer','vmlinux':'vmlinux','rootfs.ext4':'rootfs.ext4.zst','outpost-vm-launcher.service':'outpost-vm-launcher.service','tmpfiles':'outpost-tmpfiles.conf','uninstall-server':'uninstall-server'}
def pairs(values):
 result={}
 for k,v in values:
  if k in result: raise ValueError('duplicate JSON key')
  result[k]=v
 return result
fd=os.open(sys.argv[1],os.O_RDONLY|os.O_NOFOLLOW)
with os.fdopen(fd,'rb') as f:
 if not stat.S_ISREG(os.fstat(f.fileno()).st_mode): raise ValueError('invalid manifest file')
 m=json.load(f,object_pairs_hook=pairs)
if set(m)!={'version','architecture','assets'} or m['version']!=sys.argv[2] or m['architecture']!='amd64' or len(m['assets'])!=len(required): raise SystemExit('invalid manifest')
seen=set(); lines=[]
for a in m['assets']:
 if not isinstance(a,dict) or set(a)!={'name','file','sha256','url'} or required.get(a.get('name'))!=a.get('file') or a['name'] in seen or not re.fullmatch(r'[a-f0-9]{64}',a['sha256']): raise SystemExit('invalid asset')
 u=urllib.parse.urlsplit(a['url'])
 if u.scheme!='https' or not u.netloc or u.username or u.password or u.query or u.fragment or not re.fullmatch(r'/[A-Za-z0-9._~/%+-]*',u.path): raise SystemExit('invalid asset URL')
 seen.add(a['name']); lines.append(a['file']+' '+a['url'])
open(sys.argv[3],'w').write('\n'.join(lines)+'\n')
with open(sys.argv[4],'x') as f: json.dump(m,f)
PY
if [ "$source" = "$stage" ]; then
 while IFS=' ' read -r file url; do
  curl --fail --location --proto '=https' --tlsv1.2 -o "$source/$file" "$url"
 done < "$stage/downloads"
fi
# Stage regular files by descriptor, hash while copying, and reject changed input.
python3 - "$source" "$stage/verified" "$stage/validated-assets.json" <<'PY'
import hashlib,json,os,stat,sys
source,out,manifest=sys.argv[1:]; os.mkdir(out)
m=json.load(open(manifest))
for a in m['assets']:
 fd=os.open(os.path.join(source,a['file']),os.O_RDONLY|os.O_NOFOLLOW)
 with os.fdopen(fd,'rb') as src, open(os.path.join(out,a['file']),'xb') as dst:
  before=os.fstat(src.fileno())
  if not stat.S_ISREG(before.st_mode): raise ValueError('invalid asset file')
  h=hashlib.sha256()
  for chunk in iter(lambda:src.read(1024*1024),b''): h.update(chunk); dst.write(chunk)
  after=os.fstat(src.fileno())
  if (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns)!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns) or h.hexdigest()!=a['sha256']: raise ValueError('asset changed or checksum mismatch: '+a['file'])
# Keep the verified manifest for constructing runtime checksums below.
with open(out+'/release-assets.json','x') as f: json.dump(m,f)
PY
python3 - "$stage/verified" <<'PY'
import os,subprocess,sys
root=sys.argv[1]; target=root+'/rootfs.ext4'
p=subprocess.Popen(['zstd','-dq','-c',root+'/rootfs.ext4.zst'],stdout=subprocess.PIPE)
try:
 with open(target,'xb') as f:
  size=0
  for chunk in iter(lambda:p.stdout.read(1024*1024),b''):
   size+=len(chunk)
   if not chunk.strip(b'\0'): f.seek(len(chunk),1)
   else: f.write(chunk)
  if p.wait()!=0: raise ValueError('invalid compressed disk')
  f.truncate(size)
except BaseException:
 p.kill(); p.wait(); raise
PY
# All downloads and validation must succeed before interrupting an installation.
# Stop the old launcher before changing shared binaries, ownership or rootfs.
if [ "$test_mode" != 1 ]; then
 if [ "$(systemctl show -p LoadState --value outpost-vm-launcher.service)" != not-found ]; then
  printf 'Stopping the existing launcher and its VMs before upgrading.\n'
  systemctl stop outpost-vm-launcher.service
  [ "$(systemctl show -p ActiveState --value outpost-vm-launcher.service)" = inactive ] || { echo 'launcher did not stop; refusing to replace files' >&2; exit 1; }
 fi
 getent group outpost >/dev/null || groupadd --system outpost
 getent group outpostvm >/dev/null || groupadd --system outpostvm
 id outpostvm >/dev/null 2>&1 || useradd --system --gid outpostvm --home-dir /nonexistent --shell /usr/sbin/nologin outpostvm
 owner=root:root; vm_owner=root:outpostvm; socket_owner=root:outpost
else
 owner=${OUTPOST_INSTALL_UID:-$(id -u)}:${OUTPOST_INSTALL_GID:-$(id -g)}; vm_owner=$owner; socket_owner=$owner
fi
# Do not preserve the old daemon layout or open its user-writable SQLite files.
for path in /var/lib/outpost /var/lib/outpost/images /var/lib/outpost/images/default /srv/outpost/state /etc/outpost; do
 install -d -m 0700 "$root$path"; chown "$owner" "$root$path"
done
install -d -m 0750 "$root/srv/outpost/jailer" "$root/run/outpost" "$root/usr/local/lib/outpost/launcher"
chown "$vm_owner" "$root/srv/outpost/jailer" "$root/usr/local/lib/outpost/launcher"
chown "$socket_owner" "$root/run/outpost"
install -d -m 0755 "$root/usr/local/lib/outpost" "$root/usr/local/bin" "$root/etc/systemd/system" "$root/usr/lib/tmpfiles.d"
probe=$root/srv/outpost/state/.outpost-hardlink-probe
: > "$probe"
ln "$probe" "$root/srv/outpost/jailer/.outpost-hardlink-probe" || { rm -f "$probe"; echo 'state and jail must support hardlinks' >&2; exit 1; }
rm -f "$probe" "$root/srv/outpost/jailer/.outpost-hardlink-probe"
for name in outpost uninstall-server; do
 install -m 0755 "$stage/verified/$name" "$root/usr/local/lib/outpost/.$name.new"
 chown "$owner" "$root/usr/local/lib/outpost/.$name.new"
 mv "$root/usr/local/lib/outpost/.$name.new" "$root/usr/local/lib/outpost/$name"
done
ln -sfn /usr/local/lib/outpost/outpost "$root/usr/local/bin/outpost"
for name in outpost-vm-launcher firecracker jailer vmlinux; do
 mode=0750; [ "$name" != vmlinux ] || mode=0640
 install -m "$mode" "$stage/verified/$name" "$root/usr/local/lib/outpost/launcher/.$name.new"
 chown "$vm_owner" "$root/usr/local/lib/outpost/launcher/.$name.new"
 mv "$root/usr/local/lib/outpost/launcher/.$name.new" "$root/usr/local/lib/outpost/launcher/$name"
done
cp --sparse=always "$stage/verified/rootfs.ext4" "$root/var/lib/outpost/images/default/.rootfs.new"
chmod 0640 "$root/var/lib/outpost/images/default/.rootfs.new"; chown "$owner" "$root/var/lib/outpost/images/default/.rootfs.new"
mv "$root/var/lib/outpost/images/default/.rootfs.new" "$root/var/lib/outpost/images/default/rootfs.ext4"
python3 - "$stage/verified" "$root/usr/local/lib/outpost/assets.json" <<'PY'
import hashlib,json,sys
source,target=sys.argv[1:]; m=json.load(open(source+'/release-assets.json'))
assets=[]
for a in m['assets']:
 if a['name'] not in ('outpost','outpost-vm-launcher','firecracker','jailer','vmlinux','rootfs.ext4'): continue
 a=dict(a)
 if a['name']=='rootfs.ext4':
  a['file']='rootfs.ext4'; h=hashlib.sha256()
  with open(source+'/rootfs.ext4','rb') as f:
   for chunk in iter(lambda:f.read(1024*1024),b''): h.update(chunk)
  a['sha256']=h.hexdigest()
 assets.append(a)
m['assets']=assets
with open(target,'w') as f: json.dump(m,f,sort_keys=True,separators=(',',':'))
PY
chown "$owner" "$root/usr/local/lib/outpost/assets.json"; chmod 0644 "$root/usr/local/lib/outpost/assets.json"
printf 'OUTPOST_UPLINK=%s\n' "$uplink" > "$root/etc/outpost/launcher.env"
chown "$owner" "$root/etc/outpost/launcher.env"; chmod 0600 "$root/etc/outpost/launcher.env"
install -m 0644 "$stage/verified/outpost-vm-launcher.service" "$root/etc/systemd/system/outpost-vm-launcher.service"
install -m 0644 "$stage/verified/outpost-tmpfiles.conf" "$root/usr/lib/tmpfiles.d/outpost.conf"
if [ "$test_mode" != 1 ]; then
 if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qx 'Status: active'; then ufw route allow out on "$uplink" from 172.30.0.0/16; fi
 systemctl daemon-reload
 systemctl enable outpost-vm-launcher.service
 systemctl restart outpost-vm-launcher.service
 python3 - <<'PY'
import subprocess,time
end=time.monotonic()+30
while time.monotonic()<end:
 try:
  result=subprocess.run(['/usr/local/bin/outpost','list'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=2)
  if result.returncode==0: break
 except (OSError,subprocess.TimeoutExpired): pass
 time.sleep(.2)
else: raise SystemExit('launcher is not ready; inspect journalctl -u outpost-vm-launcher.service')
PY
fi
if [ -n "$admin_user" ] && [ "$test_mode" != 1 ]; then
 usermod -aG outpost "$admin_user"
 printf 'Granted %s privileged Outpost management access. Start a new login session or run newgrp outpost to activate it.\n' "$admin_user"
fi
printf 'Installed one launcher. Use sudo outpost, or a trusted member of the outpost group.\n'
