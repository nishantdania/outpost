#!/bin/sh
# Remove a launcher-only installation. Does not manage the retired API daemon.
set -eu
fail() { printf '%s\n' "$*" >&2; exit 1; }
root=${OUTPOST_UNINSTALL_ROOT:-}
test_mode=${OUTPOST_UNINSTALL_TEST:-0}
[ "$test_mode" != 1 ] || [ -n "$root" ] || fail 'test mode requires a root directory'
[ -z "$root" ] || [ "$test_mode" = 1 ] || fail 'root override is only available in test mode'
case "$root" in /|*/../*|*/..|*/./*|*/.) fail 'unsafe test root';; ''|/*) :;; *) fail 'test root must be absolute';; esac
yes=0
for option in "$@"; do
 case "$option" in
  --yes) yes=1;;
  --help) printf 'Usage: uninstall-server [--yes]\nRemoves launcher software, configuration, ALL VMs, saved images and metadata.\n'; exit 0;;
  *) fail "unknown option: $option";;
 esac
done
if [ "$test_mode" != 1 ]; then
 [ "$(id -u)" = 0 ] || fail 'must run as root'
 for command in systemctl python3; do command -v "$command" >/dev/null 2>&1 || fail "missing $command"; done
fi
# An old deployment needs its own uninstaller; never mix the two data layouts.
for path in /var/lib/outpostd /etc/systemd/system/outpostd.service; do
 if [ -e "$root$path" ] || [ -L "$root$path" ]; then
  fail "retired installation found at $path; use its matching uninstaller"
 fi
done
for path in /etc/outpost /var/lib/outpost /srv /srv/outpost /srv/outpost/state /srv/outpost/jailer /run/outpost /usr/local/lib/outpost; do
 [ ! -L "$root$path" ] || fail "refusing symlink: $path"
done
printf 'WARNING: this deletes ALL Outpost VM disks, saved images and metadata. No backup is created.\n' >&2
if [ "$yes" != 1 ]; then
 printf 'Type uninstall to continue: ' >&2
 IFS= read -r answer
 [ "$answer" = uninstall ] || fail 'uninstall cancelled'
fi
if [ "$test_mode" != 1 ]; then
 if [ "$(systemctl show -p LoadState --value outpost-vm-launcher.service)" != not-found ]; then
  # Reconcile surviving jailed processes before asking the launcher to stop all
  # VMs. Do not delete any state if startup or graceful shutdown fails.
  systemctl start outpost-vm-launcher.service
  python3 - <<'PY'
import subprocess,time
end=time.monotonic()+30
while time.monotonic()<end:
 try:
  result=subprocess.run(['/usr/local/bin/outpost','list'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=2)
  if result.returncode==0: break
 except (OSError,subprocess.TimeoutExpired): pass
 time.sleep(.2)
else: raise SystemExit('launcher did not become ready; refusing to delete VM state')
PY
  systemctl stop outpost-vm-launcher.service
  [ "$(systemctl show -p ActiveState --value outpost-vm-launcher.service)" = inactive ] || fail 'launcher did not stop; refusing to delete state'
  systemctl disable outpost-vm-launcher.service
 fi
 # Also protect partial-uninstall retries where the unit file is already gone.
 python3 - <<'PY'
from pathlib import Path
for entry in Path('/proc').iterdir():
 if not entry.name.isdigit(): continue
 try: exe=(entry/'exe').readlink().as_posix()
 except FileNotFoundError: continue
 if exe.startswith(('/usr/local/lib/outpost/','/srv/outpost/jailer/')):
  raise SystemExit('Outpost process still running (PID '+entry.name+'); refusing to delete state')
PY
fi
rm -f "$root/etc/systemd/system/outpost-vm-launcher.service" "$root/usr/lib/tmpfiles.d/outpost.conf"
# Do not delete an unrelated executable that replaced our CLI symlink.
if [ -L "$root/usr/local/bin/outpost" ]; then
 [ "$(readlink "$root/usr/local/bin/outpost")" != /usr/local/lib/outpost/outpost ] || rm -f "$root/usr/local/bin/outpost"
fi
rm -rf "$root/usr/local/lib/outpost" "$root/etc/outpost" "$root/var/lib/outpost" "$root/srv/outpost/state" "$root/srv/outpost/jailer" "$root/run/outpost"
rmdir "$root/srv/outpost" 2>/dev/null || :
if [ "$test_mode" != 1 ]; then systemctl daemon-reload; fi
printf 'Removed launcher, host CLI and all Outpost data.\nThe outpost group and outpostvm account/group are retained for administrator review.\nWorkstation CLI copies in ~/.local/bin, if any, must be removed separately.\n'
