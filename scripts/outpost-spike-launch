#!/usr/bin/env bash
# Launch one manually managed, jailed Firecracker VM. Run as root.
set -euo pipefail
IFS=$'\n\t'

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config=${OUTPOST_SPIKE_CONFIG:-"$here/outpost-spike.env"}
[[ ${EUID} -eq 0 ]] || { echo "run as root" >&2; exit 1; }
[[ -r $config ]] || { echo "missing configuration: $config (copy outpost-spike.env.example)" >&2; exit 1; }
# The config is root-controlled and contains assignments only.
# shellcheck disable=SC1090
source "$config"

valid_ipv4() {
  local ip=$1 octet
  local -a octets
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  local IFS=.
  read -r -a octets <<< "$ip"
  for octet in "${octets[@]}"; do (( 10#$octet <= 255 )) || return 1; done
}
usage() { echo "usage: $0 <id> --ssh-public-key <path> [--cpus N] [--memory-mib N] [--disk-gib N]" >&2; exit 2; }
[[ $# -gt 0 ]] || usage
id=$1
shift
ssh_public_key=''
cpus=1
memory_mib=512
disk_gib=4
while [[ $# -gt 0 ]]; do
  case $1 in
    --ssh-public-key) ssh_public_key=${2:-}; shift 2 ;;
    --cpus) cpus=${2:-}; shift 2 ;;
    --memory-mib) memory_mib=${2:-}; shift 2 ;;
    --disk-gib) disk_gib=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ $id =~ ^[A-Za-z0-9-]{1,64}$ ]] || { echo "id must be 1-64 alphanumeric or hyphen characters" >&2; exit 2; }
[[ $cpus =~ ^[1-9][0-9]*$ && $memory_mib =~ ^[1-9][0-9]*$ && $disk_gib =~ ^[1-9][0-9]*$ && $disk_gib -le 1024 ]] || { echo "resources must be positive integers (disk at most 1024 GiB)" >&2; exit 2; }
[[ -f $ssh_public_key ]] || { echo "an SSH public key file is required" >&2; exit 2; }
if ! [[ $(wc -l < "$ssh_public_key") -eq 1 ]] || ! grep -Eq '^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/=]+( .*)?$' "$ssh_public_key"; then
  echo "public key must contain exactly one OpenSSH public key" >&2
  exit 2
fi
for value in "$FIRECRACKER" "$JAILER" "$KERNEL" "$BASE_ROOTFS" "$RUNTIME_BASE" "$JAILER_BASE" "$UPLINK_IFACE"; do
  [[ $value != *[[:space:]]* ]] || { echo "configured paths and interface may not contain whitespace" >&2; exit 2; }
done
[[ $RUNTIME_BASE == /* && $RUNTIME_BASE != / && $JAILER_BASE == /* && $JAILER_BASE != / ]] || { echo "runtime and jail bases must be non-root absolute paths" >&2; exit 2; }
valid_ipv4 "$DNS_SERVER" || { echo "DNS_SERVER must be a valid IPv4 address" >&2; exit 2; }
for digest in "$FIRECRACKER_SHA256" "$JAILER_SHA256" "$KERNEL_SHA256" "$BASE_ROOTFS_SHA256"; do
  [[ $digest =~ ^[a-fA-F0-9]{64}$ ]] || { echo "all asset SHA-256 values must be set" >&2; exit 2; }
done
[[ -x $FIRECRACKER && -x $JAILER && -f $KERNEL && -f $BASE_ROOTFS ]] || { echo "configured assets are missing or not executable" >&2; exit 1; }
sha256sum -c - <<EOF
$FIRECRACKER_SHA256  $FIRECRACKER
$JAILER_SHA256  $JAILER
$KERNEL_SHA256  $KERNEL
$BASE_ROOTFS_SHA256  $BASE_ROOTFS
EOF
"$FIRECRACKER" --version | grep -Fq "$FIRECRACKER_VERSION"
"$JAILER" --version | grep -Fq "$FIRECRACKER_VERSION"
exec_name=$(basename -- "$FIRECRACKER")
[[ $exec_name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Firecracker executable name is invalid" >&2; exit 2; }
id -u "$OUTPOSTVM_USER" >/dev/null
getent group "$OUTPOSTVM_GROUP" >/dev/null
[[ $(sysctl -n net.ipv4.ip_forward) == 1 ]] || { echo "net.ipv4.ip_forward must already be enabled by host policy" >&2; exit 1; }
ip link show "$UPLINK_IFACE" >/dev/null

hash=$(printf '%s' "$id" | sha256sum | cut -c1-4)
subnet=$((16#$hash & 16383))
offset=$((subnet * 4))
third=$((offset / 256))
fourth=$((offset % 256))
gateway="172.30.$third.$((fourth + 1))"
guest_ip="172.30.$third.$((fourth + 2))"
tap="outpost${hash}"
mac="02:fc:${hash:0:2}:${hash:2:2}:${hash:0:2}:${hash:2:2}"
runtime="$RUNTIME_BASE/vms/$id"
jail_root="$JAILER_BASE/$exec_name/$id/root"
rootfs="$jail_root/rootfs.ext4"
metadata="$runtime/runtime.json"
[[ ! -e $runtime && ! -e $jail_root ]] || { echo "runtime already exists for $id; delete it first" >&2; exit 1; }
if ip link show "$tap" >/dev/null 2>&1; then
  echo "derived TAP $tap already exists; choose another ID" >&2
  exit 1
fi
mkdir -p "$runtime" "$jail_root"
chmod 0700 "$runtime" "$jail_root"
cleanup_on_error() { "$here/outpost-spike-delete" "$id" >/dev/null 2>&1 || true; }
trap cleanup_on_error ERR

base_bytes=$(stat -c '%s' "$BASE_ROOTFS")
target_bytes=$((disk_gib * 1024 * 1024 * 1024))
(( target_bytes >= base_bytes )) || { echo "requested disk is smaller than the base rootfs" >&2; exit 2; }
cp --reflink=auto --sparse=always "$BASE_ROOTFS" "$rootfs"
truncate -s "$target_bytes" "$rootfs"
e2fsck -fy "$rootfs" >/dev/null
resize2fs "$rootfs" >/dev/null
# Remove cloned host identity before installing fresh per-VM host keys.
for key in rsa ecdsa ed25519; do
  debugfs -w -R "rm /etc/ssh/ssh_host_${key}_key" "$rootfs" >/dev/null 2>&1 || true
  debugfs -w -R "rm /etc/ssh/ssh_host_${key}_key.pub" "$rootfs" >/dev/null 2>&1 || true
done
if debugfs -R 'ls -p /etc/ssh' "$rootfs" 2>/dev/null | grep -q 'ssh_host_.*_key'; then
  echo "could not remove cloned SSH host keys" >&2
  exit 1
fi
install -m 0600 "$ssh_public_key" "$runtime/authorized_keys"
debugfs -w -R 'rm /root/.ssh/authorized_keys' "$rootfs" >/dev/null 2>&1 || true
debugfs -w -R "write $runtime/authorized_keys /root/.ssh/authorized_keys" "$rootfs" >/dev/null
printf 'nameserver %s\n' "$DNS_SERVER" > "$runtime/resolv.conf"
chmod 0644 "$runtime/resolv.conf"
debugfs -w -R 'rm /etc/resolv.conf' "$rootfs" >/dev/null 2>&1 || true
debugfs -w -R "write $runtime/resolv.conf /etc/resolv.conf" "$rootfs" >/dev/null
debugfs -w -R 'set_inode_field /etc/resolv.conf mode 0100644' "$rootfs" >/dev/null
debugfs -w -R 'set_inode_field /etc/resolv.conf uid 0' "$rootfs" >/dev/null
debugfs -w -R 'set_inode_field /etc/resolv.conf gid 0' "$rootfs" >/dev/null
for key_type in rsa ecdsa ed25519; do
  key_path="$runtime/ssh_host_${key_type}_key"
  case $key_type in
    rsa) ssh-keygen -q -t rsa -b 4096 -N '' -f "$key_path" ;;
    ecdsa) ssh-keygen -q -t ecdsa -b 521 -N '' -f "$key_path" ;;
    ed25519) ssh-keygen -q -t ed25519 -N '' -f "$key_path" ;;
  esac
  debugfs -w -R "write $key_path /etc/ssh/ssh_host_${key_type}_key" "$rootfs" >/dev/null
  debugfs -w -R "write $key_path.pub /etc/ssh/ssh_host_${key_type}_key.pub" "$rootfs" >/dev/null
  debugfs -w -R "set_inode_field /etc/ssh/ssh_host_${key_type}_key mode 0100600" "$rootfs" >/dev/null
  debugfs -w -R "set_inode_field /etc/ssh/ssh_host_${key_type}_key.pub mode 0100644" "$rootfs" >/dev/null
  for field in uid gid; do
    debugfs -w -R "set_inode_field /etc/ssh/ssh_host_${key_type}_key $field 0" "$rootfs" >/dev/null
    debugfs -w -R "set_inode_field /etc/ssh/ssh_host_${key_type}_key.pub $field 0" "$rootfs" >/dev/null
  done
done
rm -f "$runtime"/ssh_host_*_key "$runtime"/ssh_host_*_key.pub
chown "$OUTPOSTVM_USER:$OUTPOSTVM_GROUP" "$rootfs"
chmod 0600 "$rootfs"
install -o "$OUTPOSTVM_USER" -g "$OUTPOSTVM_GROUP" -m 0400 "$KERNEL" "$jail_root/vmlinux"
printf '{"boot-source":{"kernel_image_path":"/vmlinux","boot_args":"console=ttyS0 reboot=k panic=1 ip=%s::%s:255.255.255.252::eth0:off"},"drives":[{"drive_id":"rootfs","path_on_host":"/rootfs.ext4","is_root_device":true,"is_read_only":false}],"machine-config":{"vcpu_count":%s,"mem_size_mib":%s},"network-interfaces":[{"iface_id":"eth0","host_dev_name":"%s","guest_mac":"%s"}]}' "$guest_ip" "$gateway" "$cpus" "$memory_mib" "$tap" "$mac" > "$jail_root/config.json"
chown "$OUTPOSTVM_USER:$OUTPOSTVM_GROUP" "$jail_root/config.json"
chmod 0400 "$jail_root/config.json"
ip tuntap add dev "$tap" mode tap user "$OUTPOSTVM_USER"
ip link set dev "$tap" alias "outpost-spike:$id"
ip addr add "$gateway/30" dev "$tap"
ip link set "$tap" up
nft list table inet outpost_spike >/dev/null 2>&1 || nft add table inet outpost_spike
nft list chain inet outpost_spike forward >/dev/null 2>&1 || nft 'add chain inet outpost_spike forward { type filter hook forward priority filter; policy accept; }'
nft list chain inet outpost_spike postrouting >/dev/null 2>&1 || nft 'add chain inet outpost_spike postrouting { type nat hook postrouting priority srcnat; policy accept; }'
nft add rule inet outpost_spike forward iifname "$tap" oifname "$UPLINK_IFACE" accept comment "\"outpost-spike:$id:out\""
nft add rule inet outpost_spike forward iifname "$UPLINK_IFACE" oifname "$tap" ct state established,related accept comment "\"outpost-spike:$id:in\""
nft add rule inet outpost_spike postrouting ip saddr "$guest_ip" oifname "$UPLINK_IFACE" masquerade comment "\"outpost-spike:$id:nat\""
printf '{"id":"%s","pid":null,"process_starttime":null,"tap":"%s","guest_ip":"%s","gateway":"%s","uplink":"%s","jail_root":"%s"}\n' "$id" "$tap" "$guest_ip" "$gateway" "$UPLINK_IFACE" "$jail_root" > "$metadata"
chmod 0600 "$metadata"
log="$runtime/firecracker.log"
: > "$log"
chmod 0600 "$log"
"$JAILER" --id "$id" --exec-file "$FIRECRACKER" --uid "$(id -u "$OUTPOSTVM_USER")" --gid "$(getent group "$OUTPOSTVM_GROUP" | cut -d: -f3)" --chroot-base-dir "$JAILER_BASE" --cgroup-version 2 --resource-limit no-file=1024 -- --api-sock /firecracker.sock --config-file /config.json < /dev/null > "$log" 2>&1 &
jailer_pid=$!
for _ in {1..100}; do [[ -r $jail_root/$exec_name.pid ]] && break; kill -0 "$jailer_pid" 2>/dev/null || { echo "jailer exited; see $log" >&2; exit 1; }; sleep 0.1; done
[[ -r $jail_root/$exec_name.pid ]] || { echo "Firecracker PID was not written; see $log" >&2; exit 1; }
pid=$(<"$jail_root/$exec_name.pid")
starttime=$(awk '{print $22}' "/proc/$pid/stat")
printf '{"id":"%s","pid":%s,"process_starttime":"%s","tap":"%s","guest_ip":"%s","gateway":"%s","uplink":"%s","jail_root":"%s"}\n' "$id" "$pid" "$starttime" "$tap" "$guest_ip" "$gateway" "$UPLINK_IFACE" "$jail_root" > "$metadata"
scanned_key="$runtime/guest_host_key"
for _ in {1..120}; do
  if ssh-keyscan -T 1 -t ed25519,ecdsa,rsa "$guest_ip" > "$scanned_key.tmp" 2>/dev/null && [[ -s $scanned_key.tmp ]]; then
    mv "$scanned_key.tmp" "$scanned_key"
    chmod 0600 "$scanned_key"
    printf 'sshd ready: root@%s (tap %s)\n' "$guest_ip" "$tap"
    printf 'scanned guest host key(s):\n'
    cat "$scanned_key"
    printf 'scanned guest host key fingerprint(s):\n'
    ssh-keygen -lf "$scanned_key" -E sha256
    printf 'from a laptop: ssh -o StrictHostKeyChecking=accept-new -J user@server root@%s\n' "$guest_ip"
    trap - ERR
    exit 0
  fi
  rm -f "$scanned_key.tmp"
  sleep 1
done
cleanup_on_error
echo "SSH did not become ready; partial launch resources were cleaned" >&2
exit 1
