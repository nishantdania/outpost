[Unit]
Description=arkd API daemon
Wants=network-online.target
Requires=ark-vm-launcher.service
After=network-online.target ark-vm-launcher.service

[Service]
Type=exec
User=arkd
Group=arkd
EnvironmentFile=@CONFIG@/arkd.env
UMask=0077
ExecStart=@PREFIX@/lib/ark/arkd --listen=@LISTEN@ --database=@STATE@/ark.db
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
SupplementaryGroups=arkd
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@STATE@ @RUNTIME@

[Install]
WantedBy=multi-user.target
