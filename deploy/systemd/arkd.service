[Unit]
Description=arkd API daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=arkd
Group=arkd
EnvironmentFile=/etc/arkd/arkd.env
UMask=0077
ExecStart=/usr/local/bin/arkd --listen=127.0.0.1:17890 --database=/var/lib/arkd/ark.db
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=arkd
RuntimeDirectory=arkd
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
