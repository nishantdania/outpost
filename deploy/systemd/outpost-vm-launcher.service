[Unit]
Description=Outpost VM manager
After=network-online.target local-fs.target systemd-tmpfiles-setup.service
Wants=network-online.target systemd-tmpfiles-setup.service
RequiresMountsFor=/var/lib/outpost /srv/outpost

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=/etc/outpost/launcher.env
ExecStart=/usr/local/lib/outpost/launcher/outpost-vm-launcher --database=/var/lib/outpost/outpost.db --socket-group=outpost --state-dir=/srv/outpost/state --jailer-base=/srv/outpost/jailer --firecracker=/usr/local/lib/outpost/launcher/firecracker --jailer=/usr/local/lib/outpost/launcher/jailer --kernel=/usr/local/lib/outpost/launcher/vmlinux --default-rootfs=/var/lib/outpost/images/default/rootfs.ext4 --image-store=/var/lib/outpost/images --uplink=${OUTPOST_UPLINK}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=3min
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/outpost /srv/outpost /run/outpost /sys/fs/cgroup
ReadOnlyPaths=/usr/local/lib/outpost/launcher
PrivateDevices=false
DeviceAllow=/dev/kvm rwm
DeviceAllow=/dev/net/tun rwm
DeviceAllow=/dev/userfaultfd rwm
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
