[Unit]
Description=Ark privileged VM launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
Group=arkd
ExecStart=/usr/local/bin/ark-vm-launcher
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=ark-vm-launcher
RuntimeDirectory=ark
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ark/jailer /var/lib/ark-vm-launcher /run/ark /sys/fs/cgroup
PrivateDevices=false
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
